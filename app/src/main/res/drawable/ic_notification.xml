<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon: single-colour white silhouette of the clipboard with the
  shiba's head and ears peeking over the top. Three task lines are cut out
  of the clipboard (even-odd) so it still reads as a to-do list at 24 dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- Head dome and ears -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M6.5,8.4 C6.5,5.3 8.5,3.6 11,3.6 C13.5,3.6 15.5,5.3 15.5,8.4 Z M7.4,1.2 L6.1,6.0 L9.8,4.4 Z M14.6,1.2 L15.9,6.0 L12.2,4.4 Z" />
    <!-- Clipboard with line cut-outs -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M5.5,8 H16.5 A2.5,2.5 0 0 1 19,10.5 V19.5 A2.5,2.5 0 0 1 16.5,22 H5.5 A2.5,2.5 0 0 1 3,19.5 V10.5 A2.5,2.5 0 0 1 5.5,8 Z M7,11.4 H15 V12.8 H7 Z M7,14.3 H15 V15.7 H7 Z M7,17.2 H12 V18.6 H7 Z" />
</vector>
